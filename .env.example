# HelixQ Enterprise Platform Configuration

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=HelixQ Platform

# Database (PostgreSQL ONLY)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=helixq_admin
POSTGRES_PASSWORD=helixq_secure_pass
POSTGRES_DB=helixq_db
DATABASE_URL=postgresql://helixq_admin:helixq_secure_pass@localhost:5432/helixq_db

# Security & Authentication Architecture
JWT_SECRET_KEY=helixq_super_secret_enterprise_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Configuration (For Caching & Background Workers)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# External Integration Layer
UNIPROT_API_BASE_URL=https://rest.uniprot.org/uniprotkb/

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
